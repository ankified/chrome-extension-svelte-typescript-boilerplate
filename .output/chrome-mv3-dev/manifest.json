{
  "manifest_version": 3,
  "name": "Svelte TypeScript Extension",
  "description": "A boilerplate for building a Chrome extension with Svelte and TypeScript",
  "version": "0.0.1",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "identity",
    "notifications",
    "alarms",
    "history",
    "unlimitedStorage",
    "scripting"
  ],
  "commands": {
    "open-bookmark-dialog": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      },
      "description": "Abrir dialog para novo bookmark"
    },
    "wxt:reload-extension": {
      "description": "Reload the extension during development",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*"
  ],
  "key": "",
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_title": "Popup",
    "default_popup": "popup.html"
  },
  "oauth2": {
    "client_id": "399897809633-9se6bq4s3n2sa8snc50f8fa5523v1c2u.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content-scripts/bookmark-dialog.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval' http://localhost:3000; object-src 'self';",
    "sandbox": "script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000; sandbox allow-scripts allow-forms allow-popups allow-modals; child-src 'self';"
  }
}